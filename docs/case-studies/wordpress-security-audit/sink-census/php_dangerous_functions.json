{
  "meta": {
    "title": "Comprehensive PHP dangerous-function map",
    "purpose": "The full reference of potentially-vulnerable PHP built-ins/constructs, by category and vuln class, with the taint-relevant argument. Superset of php_sink_catalog.json. Drives the coverage census \u2014 coverage = 'every call to a catalogued function enumerated'.",
    "arg_field": "sink_arg: 0-indexed dangerous argument, '*'=any, 'ret'=return is the sink, 'recv'=method receiver/URL set elsewhere, 'self'=language construct operand, 'cb:N'=argument N is a callable (second-order RCE if attacker-controlled)",
    "sources": [
      "RIPS sinks",
      "Psalm taint sinks",
      "exakat security",
      "PHPCS-Security-Audit",
      "Semgrep php",
      "OWASP PHP dangerous functions",
      "php.ini disable_functions guidance"
    ]
  },
